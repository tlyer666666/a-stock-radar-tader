   var matchedEntries = []
   for (var i = 0; i < entries.length; i++) {
@@ -391,9 +393,9 @@ Glob.prototype._processReaddir2 = function (prefix, read, abs, remain, index, in
     if (e.charAt(0) !== '.' || dotOk) {
       var m
       if (negate && !prefix) {
