diff --git a/common.js b/common.js
index 424c46e1dab1be6b6e357b0620d3efbc059ee0b8..c5790311782f79f0b48852b3094a6c10a9844b2d 100644
--- a/common.js
+++ b/common.js
@@ -120,11 +120,14 @@ function setopts (self, pattern, options) {
 function finish (self) {
   var nou = self.nounique
   var all = nou ? [] : Object.create(null)
+  // minimatch 11 can merge brace rows; their indices no longer identify
+  // individual globSet literals. Recheck only for legacy nonull/nounique.
+  var merged = self.minimatch.globSet.length !== self.minimatch.set.length
 
   for (var i = 0, l = self.matches.length; i < l; i ++) {
     var matches = self.matches[i]
     if (!matches || Object.keys(matches).length === 0) {
-      if (self.nonull) {
+      if (self.nonull && !merged) {
         // do like the shell, and spit out the literal glob
         var literal = self.minimatch.globSet[i]
         if (nou)
@@ -147,6 +150,28 @@ function finish (self) {
   if (!nou)
     all = Object.keys(all)
 
+  if ((self.nonull || nou) && merged) {
+    var actual = Array.from(new Set(all))
+    var repeated = []
+    self.minimatch.globSet.forEach(function (literal) {
+      var matcher = new Minimatch(literal, Object.assign({}, self.options, { nobrace: true }))
+      var found = actual.filter(function (file) {
+        var candidate = file
+        if (isAbsolute(literal) && !self.nomount)
+          candidate = '/' + path.relative(self.root, file).split(path.sep).join('/')
+        else if (self.absolute && !isAbsolute(literal))
+          candidate = path.relative(self.cwdAbs, file).split(path.sep).join('/')
+        return matcher.match(candidate)
+      })
+      if (nou)
+        repeated.push.apply(repeated, found)
+      if (!found.length && self.nonull)
+        (nou ? repeated : all).push(literal)
+    })
+    if (nou)
+      all = repeated
+  }
+
   if (!self.nosort)
     all = all.sort(alphasort)
 
